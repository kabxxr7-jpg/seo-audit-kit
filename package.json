{
  "name": "seo-audit-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small, tested technical SEO audit crawler: on-page checks, structured data, crawler/AI-bot access report, markdown and JSON reports. Verified against local fixture sites.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit": "tsx src/cli.ts",
    "fixtures": "tsx fixtures/serve.ts",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
